# Environment variables for the waterguru-poll compose project.
# Copy this file to `.env` next to docker-compose.yml (chmod 600), or enter the same names in
# your container manager's environment editor. Never commit the filled-in copy.
#
# Required: your WaterGuru app login and an InfluxDB 2 token that can write the bucket
# (and create it, if WG_ENSURE_BUCKET stays true).
WATERGURU_EMAIL=
WATERGURU_PASSWORD=
INFLUX_TOKEN=

# --- optional overrides (defaults shown; usually leave unset) ---
# Every one of these is passed through by docker-compose.yml, so a value set here (or in
# the environment editor) actually reaches the container.
# WATERGURU_IMAGE_TAG=latest                   # build/run this immutable versioned image tag
# HUBITAT_NETWORK=hubitat-stack_hubitat-net   # docker network your InfluxDB container is on
# INFLUX_URL=http://influxdb:8086               # InfluxDB base URL (internal compose address)
# INFLUX_ORG=home
# INFLUX_BUCKET=waterguru
# WG_STATE_DIR=/state                           # watermark + event-cursor location (volume)
# WG_BACKFILL_DAYS=365                          # first (watermark-less) run pulls this far back
# WG_WINDOW_DAYS=14                             # history query window size
# WG_OVERLAP_HOURS=48                           # re-query overlap before the watermark
# WG_MAX_RESULTS=500                            # per-window record cap requested from the API
# WG_ENSURE_BUCKET=true                         # create the InfluxDB bucket if missing
# WG_DRY_RUN=false                              # true = print line protocol, write nothing
# WG_LOG_LEVEL=INFO                             # DEBUG/INFO/WARNING/ERROR

# --- chlorine dose + tank inventory (optional; unset token = skip) ---
# Needed only by the chlorine/tank dashboard panels, which the WaterGuru cloud cannot
# supply. They come from the WaterGuru Dosing Advisor tile on a Hubitat hub, read through
# the hub's MCP server app. With HUBITAT_MCP_TOKEN set, the URL and the tile's device id
# are required (no defaults). The URL is the MCP app's local endpoint, for example
# http://<hub-ip>/apps/api/<mcp-app-id>/mcp
# HUBITAT_MCP_TOKEN=
# HUBITAT_MCP_URL=
# WG_DOSING_DEVICE_ID=
# HUBITAT_TIMEOUT=30                            # hub request timeout, seconds
